#!/usr/bin/env bash
# pmm — paymemoney CLI. Replaces the old Makefile.
#
#   pmm deploy      build image -> load into minikube -> apply k8s -> restart pods
#   pmm secret sk_... pk_...  inject both Stripe keys (never written to a repo file)
#   pmm ui          background port-forward + open browser
#   pmm ui-stop     stop the background port-forward
#   pmm port-forward  foreground port-forward (localhost:8000)
#   pmm tunnel      minikube service URL
#   pmm status      pods + services
#   pmm logs        web pod logs (-f)
#   pmm test        unit tests (pytest in .venv)
#   pmm break-api TARGET    move the API-level bug: json-body|wrong-path|no-auth|bad-amount|none
#   pmm break-k8s TARGET    move the k8s-level bug: selector|port|probe|scale0|reset
#   pmm delete      remove all k8s resources + namespace
#   pmm help        this text

set -euo pipefail
cd "$(dirname "$0")"

IMAGE="paymemoney:dev"
NAMESPACE="paymemoney"
LOCAL_PORT="8000"

usage() { sed -n '2,17p' "$0" | sed 's/^# \{0,1\}//'; }

cmd="${1:-help}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
  deploy)
    docker build -t "$IMAGE" .
    minikube image load "$IMAGE"
    kubectl apply -k k8s
    # image tag never changes, so restart pods to pick up the new image
    kubectl rollout restart deployment -n "$NAMESPACE"
    ;;

  build)  docker build -t "$IMAGE" . ;;
  load)   minikube image load "$IMAGE" ;;

  secret)
    SK=""; PK=""
    for a in "$@"; do
      case "$a" in
        STRIPE_SECRET_KEY=*)          SK="${a#*=}" ;;
        STRIPE_PUBLISHABLE_KEY=*)     PK="${a#*=}" ;;
        sk_*)                         SK="$a" ;;
        pk_*)                         PK="$a" ;;
        *) echo "unrecognized arg: $a (want sk_... and pk_...)" >&2; exit 1 ;;
      esac
    done
    [[ -z "$SK" || -z "$PK" ]] && {
      echo "usage: ./pmm secret sk_test_xxxxxxxx pk_test_yyyyyy" >&2
      echo "  (both keys required — sk_ for the payment pods, pk_ for the web pod's card form)" >&2
      exit 1
    }
    # namespace may not exist yet if `pmm secret` runs before the first `pmm deploy`
    kubectl create namespace "$NAMESPACE" --dry-run=client -o yaml | kubectl apply -f -
    kubectl create secret generic stripe-secret -n "$NAMESPACE" \
      --from-literal=STRIPE_SECRET_KEY="$SK" \
      --from-literal=STRIPE_PUBLISHABLE_KEY="$PK" \
      --dry-run=client -o yaml | kubectl apply -f -
    # restart every pod that consumes the secret (web pod uses pk_, pay pods use sk_);
    # skip silently if run before the first `pmm deploy` (no deployments yet)
    EXISTING=$(kubectl get deploy -n "$NAMESPACE" -o name 2>/dev/null \
      | grep -E '/(paymemoney|payment|debug-api|debug-k8s)$' || true)
    if [[ -n "$EXISTING" ]]; then
      kubectl rollout restart $EXISTING -n "$NAMESPACE"
    fi
    ;;

  test)
    [[ -x .venv/bin/python ]] || /opt/homebrew/bin/python3.15 -m venv .venv
    .venv/bin/pip install -q -r requirements.txt -r requirements-dev.txt
    .venv/bin/python -m pytest tests/ -v
    ;;

  break-api)
    TARGET="${1:-}"
    case "$TARGET" in
      json-body|wrong-path|no-auth|bad-amount|none) ;;
      *) echo "usage: pmm break-api {json-body|wrong-path|no-auth|bad-amount|none}" >&2; exit 1 ;;
    esac
    kubectl set env deployment/debug-api -n "$NAMESPACE" PAY_BREAK="$TARGET"
    ;;

  break-k8s)
    TARGET="${1:-}"
    [[ -z "$TARGET" ]] && { echo "usage: pmm break-k8s {selector|port|probe|scale0|reset}" >&2; exit 1; }
    ./break-k8s.sh "$TARGET"
    ;;

  status)   kubectl get pods,svc -n "$NAMESPACE" ;;
  logs)     kubectl logs -n "$NAMESPACE" -l app.kubernetes.io/name=paymemoney --tail=100 -f ;;
  tunnel)   minikube service paymemoney -n "$NAMESPACE" ;;

  port-forward)
    kubectl port-forward -n "$NAMESPACE" svc/paymemoney "$LOCAL_PORT":80
    ;;

  ui)
    # already serving? just reopen the browser
    if curl -sf --max-time 2 "http://localhost:$LOCAL_PORT/health" >/dev/null; then
      open "http://localhost:$LOCAL_PORT"
      echo "already running — opened http://localhost:$LOCAL_PORT"
      exit 0
    fi
    # something is bound but not serving (dead forward) — clear it first
    pkill -f "port-forward.*svc/paymemoney" 2>/dev/null || true
    sleep 1
    nohup kubectl port-forward -n "$NAMESPACE" svc/paymemoney "$LOCAL_PORT":80 \
      >/tmp/paymemoney-portforward.log 2>&1 &
    # wait for /health instead of a fixed sleep — pod may still be starting
    ok=""
    for _ in $(seq 1 30); do
      if curl -sf --max-time 1 "http://localhost:$LOCAL_PORT/health" >/dev/null; then
        ok=1; break
      fi
      sleep 0.5
    done
    if [[ -n "$ok" ]]; then
      open "http://localhost:$LOCAL_PORT"
      echo "opened http://localhost:$LOCAL_PORT — stop the forward with: pmm ui-stop"
    else
      echo "port-forward failed to come up — last log lines:" >&2
      tail -5 /tmp/paymemoney-portforward.log >&2
      exit 1
    fi
    ;;

  ui-stop)
    if pkill -f "port-forward.*svc/paymemoney"; then
      echo "port-forward stopped"
    else
      echo "no port-forward running"
    fi
    ;;

  delete)
    kubectl delete -k k8s
    kubectl delete namespace "$NAMESPACE" --ignore-not-found
    ;;

  help|--help|-h) usage ;;

  *)
    echo "unknown command: $cmd" >&2
    usage >&2
    exit 1
    ;;
esac
